# =========================
# 1. FRONT-END (PNPM & Vite)
# =========================
node_modules/
.pnpm-store/
.pnpm-debug.log
dist/
dist-ssr/
coverage/
*.local
*.timestamp-*.mjs
*.tsbuildinfo
.cache/

# =========================
# 2. BACK-END (Java / Maven / Gradle)
# =========================
target/
build/
.gradle/
bin/
out/
*.class
*.jar
*.war
HELP.md

# Nunca ignorar pastas de codigo-fonte que por acaso se chamem build/, bin/, target/ ou out/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/out/
!**/src/test/**/out/

# =========================
# 3. AMBIENTE, SEGREDOS & DADOS
# =========================
.env
.env.*
*.env
!.env.example

# Chaves, certificados e keystores
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Perfis do Spring com dados reais (a config versionada le tudo de variaveis de ambiente)
application-local.*
application-prod.*
application-secret*.*

# Dumps/backups de banco (migrations em db/migration/*.sql continuam versionadas)
*.dump
*.backup
dump*.sql
backup*.sql

# =========================
# 4. LINT, CACHES & LOGS
# =========================
.eslintcache
.vite/
.turbo/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

