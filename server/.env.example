# Copie para server/.env e preencha. O arquivo .env NAO deve ser commitado.
# So as tres DB_* do topo sao obrigatorias; as demais ja tem padrao no application.properties.

# ---- Banco (obrigatorias) ----
DB_URL=jdbc:postgresql://<host-do-neon>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# Alternativa (Postgres do Render/Heroku): no lugar das tres acima, so a URL unica. Use apenas sem DB_URL.
# DATABASE_URL=postgres://<usuario>:<senha>@<host>:<porta>/<database>

# ---- Banco (opcionais) ----
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=10000

# ---- Aplicacao ----
APP_NAME=consulta-interestadual-veiculos
PORT=8080
# Tempo para terminar as requisicoes em andamento ao desligar (deploy/restart)
SHUTDOWN_TIMEOUT=20s

# ---- JPA / Hibernate ----
# Manter validate: o banco e imutavel e o Hibernate nao deve alterar o schema
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
JPA_SHOW_SQL=false
JPA_TIME_ZONE=UTC

# ---- Flyway ----
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# ---- Erros (manter os padroes seguros fora do ambiente local) ----
ERROR_INCLUDE_STACKTRACE=never
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING_ERRORS=never
ERROR_INCLUDE_EXCEPTION=false
ERROR_WHITELABEL_ENABLED=false

# ---- CORS ----
# Origens do front separadas por virgula. Aceita curinga de subdominio para deploys de preview,
# ex.: http://localhost:5173,https://consulta-veiculos.vercel.app,https://*.vercel.app
# Evite "*" em producao (libera qualquer site).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limit ----
# Requisicoes por cliente (IPv4 ou /64 do IPv6) por minuto. Rede compartilhada (ex.: laboratorio) pode exigir valores maiores.
# O limite vale por instancia: com N replicas o limite efetivo e N vezes maior.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Limite proprio de /api/veiculos/** (consulta por placa)
RATE_LIMIT_PLACA_REQUESTS_PER_MINUTE=20
# Header com o IP real do cliente, posto pelo proxy. Vazio = IP da conexao (correto localmente).
# No Render: descubra o header com LOGGING_LEVEL_BACKEND_SECURITY=DEBUG (ver README). Nunca X-Forwarded-For.
RATE_LIMIT_IP_HEADER=
# Manter none: o IP do rate limit vem de RATE_LIMIT_IP_HEADER
FORWARD_HEADERS_STRATEGY=none

# ---- Logs ----
# Diagnostico temporario do IP do cliente no deploy (desligue depois)
# LOGGING_LEVEL_BACKEND_SECURITY=DEBUG

# ---- Swagger ----
# Mantenha false fora da maquina local: true publica /swagger-ui.html e /v3/api-docs (mapa completo da API)
SWAGGER_ENABLED=false
SWAGGER_PATH=/swagger-ui.html
