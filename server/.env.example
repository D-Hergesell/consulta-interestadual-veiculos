# Copie para server/.env e preencha. O arquivo .env NAO deve ser commitado.
# So as tres DB_* do topo sao obrigatorias; as demais ja tem padrao no application.properties.

# ---- Banco (obrigatorias) ----
DB_URL=jdbc:postgresql://<host-do-neon>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ---- Banco (opcionais) ----
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=10000

# ---- Aplicacao ----
APP_NAME=consulta-interestadual-veiculos
PORT=8080

# ---- JPA / Hibernate ----
# Manter validate: o banco e imutavel e o Hibernate nao deve alterar o schema
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
JPA_SHOW_SQL=false
JPA_TIME_ZONE=UTC

# ---- Flyway ----
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# ---- Erros (manter os padroes seguros fora do ambiente local) ----
ERROR_INCLUDE_STACKTRACE=never
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING_ERRORS=never
ERROR_INCLUDE_EXCEPTION=false
ERROR_WHITELABEL_ENABLED=false

# ---- CORS ----
# Separe varias origens por virgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limit ----
# Requisicoes por IP por minuto em /api/**. Rede compartilhada (ex.: laboratorio) pode exigir um valor maior.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# none | native | framework. So mude para native/framework atras de um proxy confiavel.
FORWARD_HEADERS_STRATEGY=none

# ---- Swagger ----
SWAGGER_ENABLED=true
SWAGGER_PATH=/swagger-ui.html
